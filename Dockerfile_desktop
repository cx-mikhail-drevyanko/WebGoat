# WebGoat container perf test image
FROM python:3.12-alpine AS stage0
RUN apk add --no-cache bind-tools zlib openssh-client libcurl jq vim curl ca-certificates
ENV APP_ID=83327
LABEL variant="451036"
FROM redis:6.2
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client curl gnupg libssl-dev && rm -rf /var/lib/apt/lists/*
ENV APP_ID=99778
LABEL variant="536899"
EXPOSE 443
CMD ["sh", "-c", "sleep infinity"]
