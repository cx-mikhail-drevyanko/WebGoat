# WebGoat container perf test image
FROM nginx:1.18 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils libssl-dev openssh-client net-tools && rm -rf /var/lib/apt/lists/*
LABEL variant="383543"
FROM mongo:6.0
RUN apt-get update && apt-get install -y --no-install-recommends libxml2 libcurl4 libssl-dev procps vim jq sqlite3 net-tools && rm -rf /var/lib/apt/lists/*
LABEL variant="535845"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
