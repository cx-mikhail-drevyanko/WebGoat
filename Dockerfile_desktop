# WebGoat container perf test image
FROM python:3.9-alpine AS stage0
RUN apk add --no-cache expat tar openssl zlib ca-certificates jq sqlite nano
ENV APP_ID=57857
LABEL variant="980321"
FROM eclipse-temurin:11-jre
RUN apt-get update && apt-get install -y --no-install-recommends perl libcurl4 unzip && rm -rf /var/lib/apt/lists/*
ENV APP_ID=12026
LABEL variant="900984"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
