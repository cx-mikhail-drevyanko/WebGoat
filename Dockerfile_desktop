# WebGoat container perf test image
FROM alpine:3.22 AS stage0
RUN apk add --no-cache busybox-extras bind-tools wget ca-certificates nano sqlite curl
ENV APP_ID=14496
LABEL variant="123363"
FROM ubuntu:24.04 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils net-tools procps openssh-client && rm -rf /var/lib/apt/lists/*
LABEL variant="426198"
FROM ruby:3.1-slim
RUN apt-get update && apt-get install -y --no-install-recommends procps libcurl4 git && rm -rf /var/lib/apt/lists/*
ENV APP_ID=60312
LABEL variant="776508"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
