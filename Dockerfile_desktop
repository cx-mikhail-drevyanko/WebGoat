# WebGoat container perf test image
FROM mysql:5.7 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils net-tools vim curl libssl-dev procps libcurl4 && rm -rf /var/lib/apt/lists/*
LABEL variant="853751"
FROM alpine:3.18 AS stage1
RUN apk add --no-cache libxml2 curl bind-tools libcurl openssh-client busybox-extras openssl expat
ENV APP_ID=12179
LABEL variant="950244"
FROM debian:9-slim
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 && rm -rf /var/lib/apt/lists/*
LABEL variant="906775"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
