# WebGoat container perf test image
FROM alpine:3.12 AS stage0
RUN apk add --no-cache bash bind-tools git sqlite wget
ENV APP_ID=2880
LABEL variant="76247"
FROM debian:9-slim
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils libssl-dev vim git && rm -rf /var/lib/apt/lists/*
ENV APP_ID=66415
LABEL variant="166422"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
