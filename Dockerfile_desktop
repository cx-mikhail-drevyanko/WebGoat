# WebGoat container perf test image
FROM nginx:1.24-alpine AS stage0
RUN apk add --no-cache openssh-client wget gzip sqlite
ENV APP_ID=44231
LABEL variant="972840"
FROM rabbitmq:3.8-alpine AS stage1
RUN apk add --no-cache tar
LABEL variant="94139"
FROM rabbitmq:3.11
RUN apt-get update && apt-get install -y --no-install-recommends gnupg dnsutils && rm -rf /var/lib/apt/lists/*
ENV APP_ID=36191
LABEL variant="38596"
EXPOSE 8080
CMD ["sh", "-c", "sleep infinity"]
