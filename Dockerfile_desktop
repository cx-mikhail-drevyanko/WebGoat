# WebGoat container perf test image
FROM node:20-alpine AS stage0
RUN apk add --no-cache ca-certificates vim zlib libxml2 bind-tools
RUN npm install handlebars@4.0.5 axios@0.18.0 moment@2.19.0 request@2.88.0
LABEL variant="62783"
FROM alpine:3.18 AS stage1
RUN apk add --no-cache tzdata nano busybox-extras
ENV APP_ID=2268
LABEL variant="649201"
FROM alpine:3.20
RUN apk add --no-cache busybox-extras libcurl curl tzdata sqlite
ENV APP_ID=51056
LABEL variant="203922"
EXPOSE 9090
CMD ["sh", "-c", "sleep infinity"]
