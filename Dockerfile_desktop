# WebGoat container perf test image
FROM postgres:11-alpine AS stage0
RUN apk add --no-cache tzdata bash git vim wget busybox-extras ca-certificates libxml2
LABEL variant="367749"
FROM redis:7.0-alpine AS stage1
RUN apk add --no-cache curl
ENV APP_ID=85340
LABEL variant="17775"
FROM node:18-alpine
RUN apk add --no-cache ca-certificates
RUN npm install handlebars@4.0.5 lodash@4.17.4
ENV APP_ID=96711
LABEL variant="130047"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
