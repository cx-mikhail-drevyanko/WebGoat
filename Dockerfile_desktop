# WebGoat container perf test image
FROM memcached:1.5 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends net-tools libcurl4 sqlite3 && rm -rf /var/lib/apt/lists/*
LABEL variant="313577"
FROM rabbitmq:3.11 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends vim openssh-client && rm -rf /var/lib/apt/lists/*
LABEL variant="981261"
FROM postgres:13-alpine
RUN apk add --no-cache bind-tools
ENV APP_ID=50287
LABEL variant="126147"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
