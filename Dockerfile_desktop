# WebGoat container perf test image
FROM nginx:1.18 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client wget nano && rm -rf /var/lib/apt/lists/*
LABEL variant="909875"
FROM alpine:3.20
RUN apk add --no-cache openssl busybox-extras
LABEL variant="76424"
EXPOSE 9090
CMD ["sh", "-c", "sleep infinity"]
