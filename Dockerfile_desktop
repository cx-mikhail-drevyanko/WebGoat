# WebGoat container perf test image
FROM centos:7 AS stage0
RUN yum install -y sqlite openssh-clients curl libxml2 openssl zlib bind-utils vim-minimal && yum clean all
LABEL variant="9419"
FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends perl libcurl4 gnupg libssl-dev procps wget openssh-client zlib1g && rm -rf /var/lib/apt/lists/*
LABEL variant="280817"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
