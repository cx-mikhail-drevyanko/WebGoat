# WebGoat container perf test image
FROM nginx:1.22 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends jq gnupg dnsutils nano && rm -rf /var/lib/apt/lists/*
LABEL variant="713254"
FROM mongo:4.4
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev gnupg && rm -rf /var/lib/apt/lists/*
ENV APP_ID=47194
LABEL variant="378803"
EXPOSE 8443
CMD ["sh", "-c", "sleep infinity"]
