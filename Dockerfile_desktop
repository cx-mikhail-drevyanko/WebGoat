# WebGoat container perf test image
FROM eclipse-temurin:11-jre
RUN apt-get update && apt-get install -y --no-install-recommends git sqlite3 openssl gnupg ca-certificates libssl-dev && rm -rf /var/lib/apt/lists/*
ENV APP_ID=90619
LABEL variant="272329"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
