# WebGoat container perf test image
FROM elasticsearch:7.17.9
RUN apt-get update && apt-get install -y --no-install-recommends unzip libxml2 git net-tools openssh-client nano libcurl4 && rm -rf /var/lib/apt/lists/*
ENV APP_ID=74170
LABEL variant="242740"
EXPOSE 443
CMD ["sh", "-c", "sleep infinity"]
