# WebGoat container perf test image
FROM nginx:1.20-alpine AS stage0
RUN apk add --no-cache wget ca-certificates bind-tools jq gzip libxml2
ENV APP_ID=56522
LABEL variant="655213"
FROM tomcat:9.0-jre11
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client libssl-dev zlib1g vim sqlite3 && rm -rf /var/lib/apt/lists/*
LABEL variant="443568"
EXPOSE 443
CMD ["sh", "-c", "sleep infinity"]
