# WebGoat container perf test image
FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends jq vim procps net-tools sqlite3 libxml2 ca-certificates && rm -rf /var/lib/apt/lists/*
ENV APP_ID=22984
LABEL variant="323110"
EXPOSE 9090
CMD ["sh", "-c", "sleep infinity"]
