# WebGoat container perf test image
FROM redis:5.0 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client jq net-tools libssl-dev libxml2 gnupg dnsutils && rm -rf /var/lib/apt/lists/*
ENV APP_ID=74980
LABEL variant="685304"
FROM fedora:34
LABEL variant="780854"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
