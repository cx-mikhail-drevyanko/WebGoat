# WebGoat container perf test image
FROM golang:1.20-alpine AS stage0
RUN apk add --no-cache ca-certificates expat nano curl libxml2 vim wget jq
ENV APP_ID=48666
LABEL variant="437271"
FROM php:8.0-cli AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev dnsutils libxml2 ca-certificates procps && rm -rf /var/lib/apt/lists/*
LABEL variant="30564"
FROM caddy:2.7-alpine
RUN apk add --no-cache bash expat bind-tools
ENV APP_ID=49679
LABEL variant="67981"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
