# WebGoat container perf test image
FROM python:3.7-slim AS stage0
RUN pip install urllib3==1.24 sqlalchemy==1.2.0 cryptography==2.3 pyyaml==5.1 flask==1.0
LABEL variant="788021"
FROM python:3.9-alpine AS stage1
RUN apk add --no-cache openssh-client curl openssl jq gzip
RUN pip install cryptography==2.3 pyyaml==5.1 numpy==1.16.0
LABEL variant="479139"
FROM php:7.4-apache
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils curl wget ca-certificates sqlite3 jq && rm -rf /var/lib/apt/lists/*
LABEL variant="231625"
EXPOSE 8443
CMD ["sh", "-c", "sleep infinity"]
