# WebGoat container perf test image
FROM elasticsearch:7.17.9
RUN apt-get update && apt-get install -y --no-install-recommends openssl libcurl4 curl procps sqlite3 ca-certificates perl libxml2 && rm -rf /var/lib/apt/lists/*
ENV APP_ID=29168
LABEL variant="82983"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
