# WebGoat container perf test image
FROM haproxy:2.0 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends zlib1g gnupg openssl sqlite3 vim && rm -rf /var/lib/apt/lists/*
ENV APP_ID=66685
LABEL variant="76576"
FROM node:20-alpine
LABEL variant="310423"
EXPOSE 8443
CMD ["sh", "-c", "sleep infinity"]
