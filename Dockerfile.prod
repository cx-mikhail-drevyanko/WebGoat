# WebGoat container perf test image
FROM ubuntu:16.04 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends unzip openssl jq && rm -rf /var/lib/apt/lists/*
LABEL variant="112614"
FROM nginx:1.20-alpine
RUN apk add --no-cache bash expat jq libcurl nano wget openssl
LABEL variant="673528"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
