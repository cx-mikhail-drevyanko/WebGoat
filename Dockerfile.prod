# WebGoat container perf test image
FROM nginx:1.26 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends gnupg procps && rm -rf /var/lib/apt/lists/*
ENV APP_ID=97330
LABEL variant="346462"
FROM python:3.8-slim
RUN apt-get update && apt-get install -y --no-install-recommends perl ca-certificates sqlite3 && rm -rf /var/lib/apt/lists/*
LABEL variant="585941"
EXPOSE 9090
CMD ["sh", "-c", "sleep infinity"]
