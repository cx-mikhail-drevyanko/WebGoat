# WebGoat container perf test image
FROM golang:1.20-alpine AS stage0
RUN apk add --no-cache gzip bind-tools
ENV APP_ID=73140
LABEL variant="930517"
FROM ubuntu:20.04 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends perl gnupg && rm -rf /var/lib/apt/lists/*
ENV APP_ID=10778
LABEL variant="286453"
FROM debian:bullseye
RUN apt-get update && apt-get install -y --no-install-recommends vim ca-certificates zlib1g perl jq && rm -rf /var/lib/apt/lists/*
ENV APP_ID=43904
LABEL variant="609339"
EXPOSE 8080
CMD ["sh", "-c", "sleep infinity"]
