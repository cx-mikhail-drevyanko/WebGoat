# WebGoat container perf test image
FROM httpd:2.4.58-alpine AS stage0
RUN apk add --no-cache libxml2 busybox-extras openssh-client nano tzdata
LABEL variant="25486"
FROM ubuntu:16.04 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends git net-tools openssh-client sqlite3 libssl-dev && rm -rf /var/lib/apt/lists/*
LABEL variant="466005"
FROM nginx:1.18
RUN apt-get update && apt-get install -y --no-install-recommends openssl net-tools zlib1g sqlite3 dnsutils gnupg ca-certificates openssh-client && rm -rf /var/lib/apt/lists/*
LABEL variant="504966"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
