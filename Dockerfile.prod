# WebGoat container perf test image
FROM postgres:13-alpine AS stage0
LABEL variant="690566"
FROM debian:9-slim AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends libxml2 libcurl4 && rm -rf /var/lib/apt/lists/*
ENV APP_ID=48394
LABEL variant="815570"
FROM node:16-slim
RUN npm install handlebars@4.0.5 lodash@4.17.4 axios@0.18.0 request@2.88.0
ENV APP_ID=8343
LABEL variant="390124"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
