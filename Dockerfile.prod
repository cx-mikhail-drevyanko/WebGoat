# WebGoat container perf test image
FROM traefik:v2.10 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends libxml2 libssl-dev vim ca-certificates wget && rm -rf /var/lib/apt/lists/*
LABEL variant="808126"
FROM node:18-slim AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends libxml2 openssl wget dnsutils && rm -rf /var/lib/apt/lists/*
RUN npm install minimist@1.2.0 handlebars@4.0.5 axios@0.18.0
LABEL variant="862728"
FROM caddy:2.7-alpine
RUN apk add --no-cache busybox-extras nano ca-certificates git curl
LABEL variant="108657"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
