# WebGoat container perf test image
FROM node:18-alpine AS stage0
RUN apk add --no-cache zlib libxml2 openssh-client nano tar openssl
RUN npm install lodash@4.17.4 moment@2.19.0 minimist@1.2.0
ENV APP_ID=63428
LABEL variant="900536"
FROM mariadb:10.3 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg libcurl4 ca-certificates && rm -rf /var/lib/apt/lists/*
LABEL variant="485942"
FROM node:14-slim
RUN apt-get update && apt-get install -y --no-install-recommends perl curl zlib1g && rm -rf /var/lib/apt/lists/*
RUN npm install moment@2.19.0
LABEL variant="779053"
EXPOSE 443
CMD ["sh", "-c", "sleep infinity"]
