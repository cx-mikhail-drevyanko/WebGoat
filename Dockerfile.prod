# WebGoat container perf test image
FROM mongo:4.4 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends wget sqlite3 net-tools curl && rm -rf /var/lib/apt/lists/*
LABEL variant="811948"
FROM ruby:2.7-slim AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends vim perl unzip curl dnsutils zlib1g jq && rm -rf /var/lib/apt/lists/*
LABEL variant="743042"
FROM golang:1.16-alpine
RUN apk add --no-cache tar jq vim libxml2 sqlite
ENV APP_ID=45202
LABEL variant="688373"
EXPOSE 9090
CMD ["sh", "-c", "sleep infinity"]
