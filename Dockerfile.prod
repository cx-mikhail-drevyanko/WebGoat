# WebGoat container perf test image
FROM node:18-slim
RUN apt-get update && apt-get install -y --no-install-recommends jq ca-certificates sqlite3 procps libxml2 && rm -rf /var/lib/apt/lists/*
RUN npm install jquery@2.2.4 minimist@1.2.0 lodash@4.17.4
ENV APP_ID=29245
LABEL variant="204072"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
