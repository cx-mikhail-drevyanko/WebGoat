# WebGoat container perf test image
FROM alpine:3.16 AS stage0
RUN apk add --no-cache busybox-extras wget bash jq openssl
ENV APP_ID=69683
LABEL variant="287989"
FROM golang:1.20-alpine AS stage1
RUN apk add --no-cache wget openssh-client libxml2 libcurl bash expat nano
ENV APP_ID=11709
LABEL variant="479855"
FROM debian:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends perl dnsutils procps && rm -rf /var/lib/apt/lists/*
ENV APP_ID=57369
LABEL variant="847329"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
