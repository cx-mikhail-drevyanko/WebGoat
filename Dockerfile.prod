# WebGoat container perf test image
FROM python:3.8-slim AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends net-tools sqlite3 ca-certificates unzip && rm -rf /var/lib/apt/lists/*
RUN pip install jinja2==2.10
LABEL variant="212239"
FROM ruby:2.7-slim AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
LABEL variant="744903"
FROM nginx:1.22
ENV APP_ID=8487
LABEL variant="225168"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
