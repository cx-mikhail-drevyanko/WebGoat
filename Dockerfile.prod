# WebGoat container perf test image
FROM node:16-alpine AS stage0
RUN apk add --no-cache vim openssh-client expat ca-certificates gzip nano bash bind-tools
ENV APP_ID=69527
LABEL variant="560538"
FROM node:20-alpine AS stage1
RUN apk add --no-cache vim tar expat libcurl
RUN npm install minimist@1.2.0 handlebars@4.0.5
LABEL variant="549710"
FROM mariadb:10.3
RUN apt-get update && apt-get install -y --no-install-recommends net-tools zlib1g perl vim gnupg libcurl4 curl ca-certificates && rm -rf /var/lib/apt/lists/*
LABEL variant="240745"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
