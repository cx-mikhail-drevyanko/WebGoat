# WebGoat container perf test image
FROM tomcat:10.1-jre17 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends zlib1g jq perl libxml2 procps ca-certificates && rm -rf /var/lib/apt/lists/*
LABEL variant="214384"
FROM mariadb:10.6 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends unzip openssh-client libxml2 && rm -rf /var/lib/apt/lists/*
ENV APP_ID=13268
LABEL variant="168684"
FROM traefik:v2.10
RUN apt-get update && apt-get install -y --no-install-recommends net-tools curl perl git sqlite3 openssh-client dnsutils && rm -rf /var/lib/apt/lists/*
ENV APP_ID=63296
LABEL variant="381649"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
