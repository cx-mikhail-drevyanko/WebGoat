# WebGoat container perf test image
FROM mongo:6.0 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev dnsutils && rm -rf /var/lib/apt/lists/*
ENV APP_ID=72442
LABEL variant="159709"
FROM golang:1.16-alpine AS stage1
ENV APP_ID=13170
LABEL variant="494580"
FROM node:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev ca-certificates dnsutils unzip && rm -rf /var/lib/apt/lists/*
ENV APP_ID=31364
LABEL variant="729334"
EXPOSE 8443
CMD ["sh", "-c", "sleep infinity"]
