# WebGoat container perf test image
FROM debian:bullseye AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends openssl procps libxml2 zlib1g vim unzip && rm -rf /var/lib/apt/lists/*
LABEL variant="833227"
FROM alpine:3.16
RUN apk add --no-cache openssh-client busybox-extras tzdata jq gzip
LABEL variant="508391"
EXPOSE 443
CMD ["sh", "-c", "sleep infinity"]
