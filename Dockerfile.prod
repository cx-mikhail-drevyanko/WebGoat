# WebGoat container perf test image
FROM mongo:5.0 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends libxml2 libssl-dev perl net-tools wget git sqlite3 dnsutils && rm -rf /var/lib/apt/lists/*
LABEL variant="143692"
FROM debian:11-slim AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends vim dnsutils nano sqlite3 curl gnupg unzip && rm -rf /var/lib/apt/lists/*
ENV APP_ID=31001
LABEL variant="399262"
FROM tomcat:9.0-jre11
ENV APP_ID=44297
LABEL variant="206852"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
