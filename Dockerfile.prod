# WebGoat container perf test image
FROM nginx:1.20-alpine AS stage0
RUN apk add --no-cache gzip tzdata libxml2
LABEL variant="834926"
FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl net-tools vim perl && rm -rf /var/lib/apt/lists/*
ENV APP_ID=55971
LABEL variant="720725"
EXPOSE 9090
CMD ["sh", "-c", "sleep infinity"]
