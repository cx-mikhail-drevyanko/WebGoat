# WebGoat container perf test image
FROM postgres:12 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends openssl procps openssh-client && rm -rf /var/lib/apt/lists/*
LABEL variant="448176"
FROM debian:12-slim AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates sqlite3 dnsutils git nano openssl && rm -rf /var/lib/apt/lists/*
LABEL variant="437399"
FROM node:16-slim
RUN apt-get update && apt-get install -y --no-install-recommends vim dnsutils libcurl4 && rm -rf /var/lib/apt/lists/*
RUN npm install moment@2.19.0
ENV APP_ID=90053
LABEL variant="992498"
EXPOSE 443
CMD ["sh", "-c", "sleep infinity"]
