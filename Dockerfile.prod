# WebGoat container perf test image
FROM traefik:v2.10 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils net-tools wget && rm -rf /var/lib/apt/lists/*
ENV APP_ID=75047
LABEL variant="7387"
FROM tomcat:9.0-jre11 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev curl git jq procps nano && rm -rf /var/lib/apt/lists/*
ENV APP_ID=27817
LABEL variant="259289"
FROM fedora:38
RUN yum install -y libxml2 wget openssh-clients bind-utils vim-minimal gzip tar && yum clean all
ENV APP_ID=94969
LABEL variant="992245"
EXPOSE 8443
CMD ["sh", "-c", "sleep infinity"]
