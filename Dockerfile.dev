# WebGoat container perf test image
FROM nginx:1.26 AS stage0
ENV APP_ID=58389
LABEL variant="425885"
FROM ruby:3.1-slim AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends unzip vim procps && rm -rf /var/lib/apt/lists/*
ENV APP_ID=65338
LABEL variant="568067"
FROM php:7.4-apache
RUN apt-get update && apt-get install -y --no-install-recommends nano ca-certificates libcurl4 git perl wget libssl-dev zlib1g && rm -rf /var/lib/apt/lists/*
LABEL variant="522159"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
