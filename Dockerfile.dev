# WebGoat container perf test image
FROM node:18-alpine AS stage0
RUN apk add --no-cache libcurl vim bind-tools tar openssh-client openssl busybox-extras
RUN npm install request@2.88.0 jquery@2.2.4 minimist@1.2.0 axios@0.18.0
ENV APP_ID=88967
LABEL variant="753240"
FROM eclipse-temurin:11-jre AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends git zlib1g dnsutils && rm -rf /var/lib/apt/lists/*
LABEL variant="303469"
FROM ubuntu:20.04
RUN apt-get update && apt-get install -y --no-install-recommends nano dnsutils libcurl4 perl ca-certificates libssl-dev git && rm -rf /var/lib/apt/lists/*
LABEL variant="901618"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
