# WebGoat container perf test image
FROM php:7.4-apache AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils libssl-dev unzip openssh-client wget zlib1g ca-certificates && rm -rf /var/lib/apt/lists/*
LABEL variant="729652"
FROM caddy:2.7-alpine AS stage1
RUN apk add --no-cache libxml2 busybox-extras curl openssl
LABEL variant="44775"
FROM ruby:2.7-slim
RUN apt-get update && apt-get install -y --no-install-recommends vim sqlite3 nano procps && rm -rf /var/lib/apt/lists/*
ENV APP_ID=17429
LABEL variant="686641"
EXPOSE 9090
CMD ["sh", "-c", "sleep infinity"]
