# WebGoat container perf test image
FROM alpine:3.10 AS stage0
RUN apk add --no-cache zlib tar expat
ENV APP_ID=8614
LABEL variant="340006"
FROM node:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends net-tools git && rm -rf /var/lib/apt/lists/*
LABEL variant="900850"
EXPOSE 8080
CMD ["sh", "-c", "sleep infinity"]
