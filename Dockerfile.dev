# WebGoat container perf test image
FROM node:20-alpine AS stage0
RUN npm install express@4.16.0 lodash@4.17.4 axios@0.18.0
ENV APP_ID=28535
LABEL variant="726069"
FROM postgres:12 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 git unzip libxml2 && rm -rf /var/lib/apt/lists/*
ENV APP_ID=73826
LABEL variant="454800"
FROM postgres:13-alpine
RUN apk add --no-cache sqlite openssl libxml2 bind-tools nano
LABEL variant="387305"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
