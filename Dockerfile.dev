# WebGoat container perf test image
FROM alpine:3.18 AS stage0
RUN apk add --no-cache nano libcurl
LABEL variant="600391"
FROM mariadb:10.3
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 dnsutils perl && rm -rf /var/lib/apt/lists/*
LABEL variant="410576"
EXPOSE 80
CMD ["sh", "-c", "sleep infinity"]
