# WebGoat container perf test image
FROM node:14-slim AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends vim jq curl nano sqlite3 libssl-dev && rm -rf /var/lib/apt/lists/*
RUN npm install jquery@2.2.4 lodash@4.17.4
ENV APP_ID=23759
LABEL variant="752687"
FROM haproxy:2.6-alpine AS stage1
LABEL variant="702310"
FROM ruby:2.7-slim
RUN apt-get update && apt-get install -y --no-install-recommends procps libxml2 libcurl4 && rm -rf /var/lib/apt/lists/*
LABEL variant="278626"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
