# WebGoat container perf test image
FROM postgres:12 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends procps net-tools curl zlib1g openssl && rm -rf /var/lib/apt/lists/*
LABEL variant="699797"
FROM nginx:1.14 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils openssl zlib1g net-tools curl && rm -rf /var/lib/apt/lists/*
ENV APP_ID=41859
LABEL variant="384160"
FROM mariadb:10.3
RUN apt-get update && apt-get install -y --no-install-recommends vim ca-certificates nano zlib1g procps libcurl4 git unzip && rm -rf /var/lib/apt/lists/*
LABEL variant="916412"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
