# WebGoat container perf test image
FROM tomcat:9.0-jre11 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 libssl-dev && rm -rf /var/lib/apt/lists/*
LABEL variant="86112"
FROM tomcat:10.1-jre17 AS stage1
ENV APP_ID=2392
LABEL variant="417491"
FROM alpine:3.20
RUN apk add --no-cache openssl curl git nano libxml2 bash busybox-extras
ENV APP_ID=46829
LABEL variant="935678"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
