# WebGoat container perf test image
FROM golang:1.20-alpine AS stage0
ENV APP_ID=40008
LABEL variant="577751"
FROM tomcat:8.5-jre8 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends libcurl4 dnsutils && rm -rf /var/lib/apt/lists/*
ENV APP_ID=3989
LABEL variant="504191"
FROM memcached:1.5
RUN apt-get update && apt-get install -y --no-install-recommends nano unzip jq libcurl4 wget && rm -rf /var/lib/apt/lists/*
ENV APP_ID=75846
LABEL variant="173105"
EXPOSE 9090
CMD ["sh", "-c", "sleep infinity"]
