# WebGoat container perf test image
FROM busybox:1.36 AS stage0
RUN apk add --no-cache vim libcurl expat
LABEL variant="882401"
FROM nginx:1.24-alpine AS stage1
RUN apk add --no-cache bind-tools busybox-extras
ENV APP_ID=78896
LABEL variant="185406"
FROM mysql:5.7
ENV APP_ID=52361
LABEL variant="144820"
EXPOSE 8443
CMD ["sh", "-c", "sleep infinity"]
