# WebGoat container perf test image
FROM ubuntu:18.04 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends zlib1g && rm -rf /var/lib/apt/lists/*
LABEL variant="29263"
FROM php:7.4-apache
RUN apt-get update && apt-get install -y --no-install-recommends vim libxml2 perl gnupg procps sqlite3 openssl && rm -rf /var/lib/apt/lists/*
LABEL variant="82442"
EXPOSE 443
CMD ["sh", "-c", "sleep infinity"]
