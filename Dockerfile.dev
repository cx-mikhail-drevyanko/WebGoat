# WebGoat container perf test image
FROM redis:5.0 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client openssl vim zlib1g unzip sqlite3 git jq && rm -rf /var/lib/apt/lists/*
LABEL variant="900056"
FROM traefik:v2.10 AS stage1
ENV APP_ID=13046
LABEL variant="136741"
FROM postgres:13-alpine
ENV APP_ID=72913
LABEL variant="686430"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
