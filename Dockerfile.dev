# WebGoat container perf test image
FROM haproxy:2.0 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends perl procps && rm -rf /var/lib/apt/lists/*
LABEL variant="923002"
FROM ruby:2.7-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg openssh-client && rm -rf /var/lib/apt/lists/*
LABEL variant="842315"
EXPOSE 8080
CMD ["sh", "-c", "sleep infinity"]
