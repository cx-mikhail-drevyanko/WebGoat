# WebGoat container perf test image
FROM eclipse-temurin:21-jre AS stage0
LABEL variant="339570"
FROM mongo:5.0
RUN apt-get update && apt-get install -y --no-install-recommends dnsutils perl procps libssl-dev zlib1g gnupg && rm -rf /var/lib/apt/lists/*
ENV APP_ID=2836
LABEL variant="566067"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
