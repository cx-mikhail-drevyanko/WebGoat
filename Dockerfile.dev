# WebGoat container perf test image
FROM memcached:1.5 AS stage0
LABEL variant="571238"
FROM php:7.4-apache
RUN apt-get update && apt-get install -y --no-install-recommends unzip git perl libcurl4 openssh-client && rm -rf /var/lib/apt/lists/*
ENV APP_ID=55672
LABEL variant="743759"
EXPOSE 5000
CMD ["sh", "-c", "sleep infinity"]
