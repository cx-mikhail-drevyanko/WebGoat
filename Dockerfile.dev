# WebGoat container perf test image
FROM memcached:1.6-alpine AS stage0
ENV APP_ID=65728
LABEL variant="341254"
FROM ruby:3.1-slim AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends openssh-client jq gnupg sqlite3 net-tools wget dnsutils && rm -rf /var/lib/apt/lists/*
ENV APP_ID=82836
LABEL variant="478876"
FROM python:3.8-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl unzip && rm -rf /var/lib/apt/lists/*
RUN pip install lxml==4.2.0
ENV APP_ID=3507
LABEL variant="951850"
EXPOSE 8080
CMD ["sh", "-c", "sleep infinity"]
