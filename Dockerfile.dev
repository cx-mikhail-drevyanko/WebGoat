# WebGoat container perf test image
FROM node:16-alpine AS stage0
RUN apk add --no-cache nano zlib libcurl gzip curl jq busybox-extras sqlite
LABEL variant="713904"
FROM python:3.12-alpine AS stage1
RUN apk add --no-cache bind-tools zlib tzdata vim tar jq libxml2 git
LABEL variant="642863"
FROM python:3.10-slim
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 jq dnsutils libxml2 libcurl4 git nano openssl && rm -rf /var/lib/apt/lists/*
RUN pip install pillow==6.2.0 sqlalchemy==1.2.0 cryptography==2.3
ENV APP_ID=57867
LABEL variant="34302"
EXPOSE 8443
CMD ["sh", "-c", "sleep infinity"]
