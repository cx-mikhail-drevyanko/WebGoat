# WebGoat container perf test image
FROM nginx:1.20-alpine AS stage0
RUN apk add --no-cache curl bind-tools
LABEL variant="114221"
FROM ubuntu:20.04 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends gnupg jq dnsutils wget && rm -rf /var/lib/apt/lists/*
LABEL variant="182416"
FROM nginx:1.26
ENV APP_ID=69919
LABEL variant="953499"
EXPOSE 8443
CMD ["sh", "-c", "sleep infinity"]
