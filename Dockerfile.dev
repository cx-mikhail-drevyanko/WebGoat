# WebGoat container perf test image
FROM php:7.4-apache AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends unzip wget nano openssh-client && rm -rf /var/lib/apt/lists/*
ENV APP_ID=44737
LABEL variant="764945"
FROM eclipse-temurin:17-jre-alpine AS stage1
RUN apk add --no-cache wget tar libcurl bash zlib libxml2
ENV APP_ID=25239
LABEL variant="322788"
FROM centos:8
LABEL variant="677932"
EXPOSE 443
CMD ["sh", "-c", "sleep infinity"]
