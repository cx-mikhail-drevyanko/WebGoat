# WebGoat container perf test image
FROM elasticsearch:7.17.9 AS stage0
RUN apt-get update && apt-get install -y --no-install-recommends libcurl4 sqlite3 nano zlib1g openssl git perl openssh-client && rm -rf /var/lib/apt/lists/*
ENV APP_ID=47098
LABEL variant="469562"
FROM mysql:8.0 AS stage1
RUN apt-get update && apt-get install -y --no-install-recommends unzip zlib1g perl curl nano openssh-client net-tools && rm -rf /var/lib/apt/lists/*
LABEL variant="21522"
FROM ruby:3.1-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates jq && rm -rf /var/lib/apt/lists/*
LABEL variant="286106"
EXPOSE 3000
CMD ["sh", "-c", "sleep infinity"]
